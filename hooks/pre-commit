#!/bin/bash
# Pre-commit hook for binary crates
# Copy to hooks/pre-commit and run hooks/install.sh

set -e

# Block #[allow(dead_code)] in staged files
staged_rs=$(git diff --cached --diff-filter=AM --name-only | grep '\.rs$' || true)
if [ -n "$staged_rs" ] && echo "$staged_rs" | xargs -r grep -nH '#\[.*allow(dead_code).*\]'; then
    echo "Found #[allow(dead_code)] in staged files. Refactor without it or get explicit approval."
    exit 1
fi

if ! cargo fmt --all -- --check; then
    echo "Code is not formatted. Run 'cargo fmt --all' to fix."
    exit 1
fi

if ! cargo clippy --all-targets --all-features --message-format=short -- -D warnings; then
    echo "Clippy found warnings. Fix them before committing."
    exit 1
fi

if ! test_output=$(cargo test --release 2>&1); then
    echo "$test_output" | tail
    echo "Tests failed. Fix them before committing."
    exit 1
fi

echo "Pre-commit checks passed"
